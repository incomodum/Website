---
import "@/styles/globals.css"
import { SEO } from "astro-seo"
import { ExternalLink, Trophy, Calendar, MapPin, Code2, Layout, Activity, Sparkles } from "lucide-react"
import Footer from "@/components/Footer"
import Header from "@/components/Header"
import sportujtoo from "/public/assets/projects/sportujtoo.webp"
import ProjectsBack from "@/components/ProjectsBack.astro"
import ThemeManager from "@/components/ThemeManager.astro"
import { Badge } from "@/components/ui/badge"
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="/apple-touch-icon.png"
		/>
		<link rel="icon" href="/favicon.png" type="image/png" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="manifest" href="/site.webmanifest" />
		<SEO
			title="Sportuj Too | incomodum"
			description="Sporting grounds reservations for the city part of Petržalka"
			openGraph={{
				basic: {
					title: "Sportuj Too",
					type: "website",
					image: "/assets/projects/sportujtoo-og.png"
				},
				optional: {
					locale: "en",
					description:
						"Sporting grounds reservations for the city part of Petržalka",
					siteName: "incomodum"
				},
				image: {
					width: 1280,
					height: 640,
					type: "image/png"
				}
			}}
			twitter={{
				card: "summary_large_image"
			}}
		/>
		<style>
			:root {
				/* Vibrant Petržalka Green */
				--page-color: oklch(0.6722 0.1768 145.74);
				--page-rgb: 46, 184, 114;
			}
		</style>
		<ThemeManager defaultTheme="auto" />
	</head>
	<body class="bg-background text-foreground selection:bg-page/30">
		<Header client:load />

		<main class="relative w-full">
			<section class="relative px-8 pt-24 pb-16 md:px-16 lg:pt-32 lg:pb-32 overflow-hidden">
				<div class="mx-auto max-w-7xl">
					<ProjectsBack />

					<div class="mt-12 grid gap-16 lg:grid-cols-2 items-center">
						<div class="space-y-8">
							<div class="space-y-4">
								<Badge className="bg-page/50 text-foreground hover:bg-page px-4 py-1 rounded-full uppercase tracking-widest text-[10px] font-bold">
									Hackathon Project
								</Badge>
								<a href="https://github.com/incomodum/Sportuj-Too" target="_blank" rel="noopener noreferrer" class="group block">
									<h1 class="text-5xl flex items-center font-black leading-[1.1] lg:text-6xl tracking-tighter transition-colors group-hover:text-page">
										Sportuj <span class="text-page">Too</span>
										<ExternalLink className="inline-block ml-4 size-8 opacity-20 group-hover:opacity-100 transition-opacity" />
									</h1>
								</a>
								<p class="text-xl text-muted-foreground leading-relaxed max-w-xl">
									A streamlined public reservation portal connecting Petržalka residents with local municipal sports facilities and outdoor grounds.
								</p>
							</div>

							<div class="flex gap-8">
								<div class="flex flex-col border-l-2 border-page/20 pl-4">
									<span class="text-xs font-bold uppercase text-muted-foreground/50">Category</span>
									<span class="font-bold">Hackathon Solution</span>
								</div>
								<div class="flex flex-col border-l-2 border-page/20 pl-4">
									<span class="text-xs font-bold uppercase text-muted-foreground/50">Target Area</span>
									<span class="font-bold">Bratislava - Petržalka</span>
								</div>
							</div>
						</div>

						<div class="relative group">
							<div class="absolute -inset-4 bg-page/5 blur-3xl rounded-full opacity-50"></div>
							<div class="relative overflow-hidden rounded-2xl shadow-2xl transition-all transform-gpu group-hover:scale-[1.02] border border-white/10">
								<img
									src={sportujtoo.src}
									alt="Sportuj Too Preview"
									class="w-full h-auto object-cover"
								/>
							</div>
							<div class="absolute -top-6 -right-6 h-32 w-32 bg-page/10 rounded-full blur-2xl -z-10"></div>
						</div>
					</div>
				</div>
			</section>

			<section class="bg-card/30 py-24 px-8 md:px-16 lg:py-32 backdrop-blur-sm border-y border-white/5">
				<div class="mx-auto max-w-7xl">
					<div class="grid gap-24 lg:grid-cols-2">
						<div class="space-y-8">
							<div class="flex items-center gap-3 text-page">
								<MapPin className="size-6" />
								<h2 class="text-3xl font-bold tracking-tight">The Challenge</h2>
							</div>
							<p class="text-lg text-muted-foreground leading-relaxed">
								Petržalka offers numerous sporting venues, but booking timeslots was often fragmented, requiring manual phone calls or outdated forms.
							</p>
							<ul class="space-y-5">
								{[
									"Lack of real-time visibility into court availability",
									"Underutilized local community sports facilities",
									"Complex booking steps for everyday citizens"
								].map((item) => (
									<li class="flex items-start gap-4 group">
										<div class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-page group-hover:scale-150 transition-all" />
										<span class="text-muted-foreground group-hover:text-foreground transition-colors">{item}</span>
									</li>
								))}
							</ul>
						</div>

						<div class="space-y-8">
							<div class="flex items-center gap-3 text-page">
								<Trophy className="size-6" />
								<h2 class="text-3xl font-bold tracking-tight">The Solution</h2>
							</div>
							<p class="text-lg text-muted-foreground leading-relaxed">
								Developed during a regional hackathon, Sportuj Too provides a frictionless digital schedule and booking flow for local grounds, making active living accessible to everyone.
							</p>

							<div class="grid gap-4 sm:grid-cols-2">
								<div class="rounded-2xl bg-card p-6 border border-white/5 group hover:border-page/20 transition-all">
									<Calendar className="text-page mb-4 size-6 group-hover:scale-110 transition-transform" />
									<h3 class="font-bold mb-2 text-sm uppercase">Instant Scheduling</h3>
									<p class="text-xs text-muted-foreground leading-relaxed">Select dates, check open slots, and reserve courts in just a few taps.</p>
								</div>
								<div class="rounded-2xl bg-card p-6 border border-white/5 group hover:border-page/20 transition-all">
									<Activity className="text-page mb-4 size-6 group-hover:rotate-12 transition-transform" />
									<h3 class="font-bold mb-2 text-sm uppercase">Civic Engagement</h3>
									<p class="text-xs text-muted-foreground leading-relaxed">Promotes active lifestyles and community involvement across Petržalka.</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="py-24 lg:py-32">
				<div class="mx-auto max-w-7xl px-8 md:px-16 text-center">
					<h2 class="mb-16 text-3xl font-bold lg:text-4xl">Technical <span class="text-page">Stack</span></h2>
					<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{[
							{ title: "Framework", tech: "Next.js", icon: <Code2 />, desc: "Fast SSR and route handling for responsive reservations." },
							{ title: "UI Engine", tech: "React & Tailwind CSS", icon: <Layout />, desc: "Clean, accessible interface designed for mobile and desktop." },
							{ title: "Prototype Design", tech: "Hackathon Standard", icon: <Sparkles />, desc: "Rapidly iterated UI focused on end-user simplicity." }
						].map((item) => (
							<div class="group rounded-[2.5rem] bg-card/50 p-10 border border-white/5 hover:bg-card transition-all transform-gpu hover:-translate-y-2">
								<div class="mx-auto mb-6 w-fit text-page group-hover:scale-110 transition-transform">
									{item.icon}
								</div>
								<h3 class="font-bold text-xs uppercase tracking-widest text-muted-foreground mb-2">{item.title}</h3>
								<p class="font-bold text-lg mb-4">{item.tech}</p>
								<p class="text-xs text-muted-foreground leading-relaxed">{item.desc}</p>
							</div>
						))}
					</div>
				</div>
			</section>

			<section class="px-8 md:px-16 pb-32">
				<div class="w-full max-w-7xl mx-auto">
					<div class="rounded-[3rem] bg-linear-to-br from-[#123E28] to-[#1C274C] p-12 text-center text-white shadow-2xl relative overflow-hidden">
						<div class="relative z-10">
							<h2 class="mb-6 text-3xl font-bold lg:text-4xl">View on GitHub</h2>
							<p class="mb-10 text-white/70 max-w-xl mx-auto">
								Explore the source code for Sportuj Too directly on GitHub.
							</p>
							<a href="https://github.com/incomodum/Sportuj-Too" target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-full bg-white px-10 py-4 font-bold text-[#123E28] hover:bg-page hover:text-white transition-all transform-gpu hover:scale-105">
								Open GitHub Repository
								<ExternalLink className="ml-2 size-4" />
							</a>
						</div>
						<div class="absolute -right-20 -bottom-20 size-80 bg-white/5 blur-3xl rounded-full"></div>
					</div>
				</div>
			</section>
		</main>

		<Footer client:load />
	</body>
</html>