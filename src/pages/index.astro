---
import "@/styles/globals.css"
import { SEO } from "astro-seo"
import { ArrowRight } from "lucide-react"
import Title from "@/components/home/Title"
import Footer from "@/components/Footer"
import Header from "@/components/Header"
import Mission from "@/components/home/Mission"
import Contact from "@/components/Contact"
import Projects from "@/components/home/Projects"
import Services from "@/components/home/Services"
import ThemeManager from "@/components/ThemeManager.astro"
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="/apple-touch-icon.png"
		/>
		<link rel="icon" href="/favicon.png" type="image/png" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="manifest" href="/site.webmanifest" />
		<SEO
			title="incomodum"
			description="Innovative Software Solutions Driving Growth and Excellence"
			openGraph={{
				basic: {
					title: "incomodum",
					type: "website",
					image: "/assets/base-og.png"
				},
				optional: {
					locale: "en",
					description:
						"Innovative Software Solutions Driving Growth and Excellence"
				},
				image: {
					width: 1280,
					height: 640,
					type: "image/png"
				}
			}}
			twitter={{
				card: "summary_large_image"
			}}
		/>
		<ThemeManager defaultTheme="auto" />
	</head>
	<body class="bg-background text-foreground selection:bg-page/30">
    <Header client:load />
    <div class="flex flex-col items-center w-full overflow-x-hidden px-6 lg:px-16">
        <main class="w-full max-w-7xl mx-auto pt-24 lg:pt-32">

            <section class="flex flex-col items-center text-center mb-24 lg:mb-32">
                <Title client:load />
            </section>

            <div id="services" class="scroll-mt-24">
                <Services client:visible />
            </div>

            <section class="mt-32 space-y-10" aria-labelledby="heading-featured-projects">
                <div class="flex flex-col md:flex-row justify-between items-end gap-4">
                    <h2 id="heading-featured-projects" class="text-4xl font-bold tracking-tight">
                        Featured <span class="text-page">Projects</span>
                    </h2>
                    <a href="/projects" class="text-page font-semibold flex items-center group">
                        View gallery <ArrowRight className="ml-2 size-4 group-hover:translate-x-1 transition-transform" />
                    </a>
                </div>
                <Projects client:visible />
            </section>

            <div id="mission" class="scroll-mt-24">
                <Mission client:visible />
            </div>

            <div id="contact" class="scroll-mt-24 pb-24">
                <Contact client:visible />
            </div>
        </main>
    </div>
    <Footer client:visible />
</body>
</html>
